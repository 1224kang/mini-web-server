#!/usr/bin/env python3
"""POST /cgi-bin/form  (application/x-www-form-urlencoded)

본문은 stdin 으로 CONTENT_LENGTH 바이트만큼 들어온다. (EOF 까지 읽지 않는다: 규칙상 길이만큼만)
"""
import html
import os
import sys
from urllib.parse import parse_qsl

method = os.environ.get("REQUEST_METHOD", "")
if method != "POST":
    sys.stdout.write("Status: 405 Method Not Allowed\r\nAllow: POST\r\n"
                     "Content-Type: text/plain; charset=utf-8\r\n\r\nPOST only\n")
    sys.exit(0)

length = int(os.environ.get("CONTENT_LENGTH") or 0)
body = sys.stdin.buffer.read(length).decode("utf-8", "replace")
fields = parse_qsl(body, keep_blank_values=True)

rows = "\n".join(f"<tr><th>{html.escape(k)}</th><td>{html.escape(v)}</td></tr>" for k, v in fields)
out = f"""<!doctype html>
<meta charset="utf-8">
<title>폼 결과</title>
<link rel="stylesheet" href="/css/style.css">
<h1>CGI 가 받은 폼</h1>
<p>pid {os.getpid()} 가 stdin 으로 {length} 바이트를 읽었습니다.</p>
<table>{rows}</table>
<p><a href="/form.html">다시 보내기</a></p>
"""
data = out.encode("utf-8")
sys.stdout.write("Content-Type: text/html; charset=utf-8\r\n\r\n")
sys.stdout.flush()
sys.stdout.buffer.write(data)
